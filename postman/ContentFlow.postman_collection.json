{
  "info": {
    "name": "ContentFlow API · Cosmos DB for MongoDB",
    "description": "Lectura/escritura en tiempo real sobre Azure Cosmos DB mediante la API REST (FastAPI + PyMongo). Ejecutar con la API levantada: uvicorn api:app --port 8000. Orden: Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A. Flujo CRUD completo",
      "item": [
        {
          "name": "01 Salud (ping a Cosmos DB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Responde en menos de 3 s (incluye red hacia Azure)', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "pm.test('Trae X-Request-ID para trazabilidad', function () { pm.response.to.have.header('X-Request-ID'); });",
                  "pm.test('estado ok y base conectada', function () { var j = pm.response.json(); pm.expect(j.estado).to.eql('ok'); pm.expect(j.documentos.publicaciones).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 LEER · Listar publicaciones de Deportes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/publicaciones?categoria=Deportes&limite=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "publicaciones"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "Deportes"
                },
                {
                  "key": "limite",
                  "value": "5"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Responde en menos de 3 s (incluye red hacia Azure)', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "pm.test('Trae X-Request-ID para trazabilidad', function () { pm.response.to.have.header('X-Request-ID'); });",
                  "pm.test('máximo 5 documentos, todos Deportes', function () { var j = pm.response.json(); pm.expect(j.datos.length).to.be.at.most(5); j.datos.forEach(function (p) { pm.expect(p.categoria).to.eql('Deportes'); }); });"
                ]
              }
