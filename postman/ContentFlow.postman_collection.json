                "publicaciones"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": \"user_1\",\n  \"contenido\": \"Publicación creada desde Postman\",\n  \"categoria\": \"Tecnología\",\n  \"tipo\": \"Texto\",\n  \"hashtags\": [\n    \"#Azure\",\n    \"#NoSQL\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Responde en menos de 3 s (incluye red hacia Azure)', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "pm.test('Trae X-Request-ID para trazabilidad', function () { pm.response.to.have.header('X-Request-ID'); });",
                  "var j = pm.response.json(); pm.collectionVariables.set('pubId', j._id);",
                  "pm.test('devuelve _id nuevo', function () { pm.expect(j._id).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
