# Configuración de Conexión a Azure Cosmos DB for MongoDB API
# Reemplaza <PRIMARY_KEY> con la clave primaria obtenida en Azure Portal (Claves de acceso)
COSMOS_CONNECTION_STRING="mongodb://cosmos-contentflow-mongo-va:<PRIMARY_KEY>@cosmos-contentflow-mongo-va.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@cosmos-contentflow-mongo-va@"
DB_NAME="contentflow_db"
